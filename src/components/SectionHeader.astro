---
interface Props {
  eyebrow: string;
  title: string;
  desc?: string;
  titleId?: string;
  centered?: boolean;
  wide?: boolean;
  /** Default h2 — use h1 only once per page (hero or page title). */
  headingLevel?: 1 | 2 | 3;
}

const {
  eyebrow,
  title,
  desc,
  titleId,
  centered = false,
  wide = false,
  headingLevel = 2,
} = Astro.props;

const HeadingTag = headingLevel === 1 ? 'h1' : headingLevel === 3 ? 'h3' : 'h2';
---

<header
  class:list={[
    'section-header space-y-0',
    wide && 'section-header--wide',
    centered && 'mx-auto text-center',
  ]}
>
  <p class="section-header__eyebrow">{eyebrow}</p>
  <HeadingTag id={titleId} class="section-header__title">{title}</HeadingTag>
  {desc ? <p class="section-header__subtitle">{desc}</p> : null}
</header>
