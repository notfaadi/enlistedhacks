---
import { cheatPages } from '../data/products';
import { cheatTierIcons } from '../data/sectionIcons';
import Icon from './icons/Icon.astro';
import type { IconName } from './icons/types';
import { productPath } from '../utils/path';
import { Badge } from '@/components/starwind/badge';
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@/components/starwind/table';

interface CompareRow {
  feature: string;
  icon: IconName;
  lite: boolean;
  pro: boolean;
  elite: boolean;
}

interface Props {
  rows: CompareRow[];
  highlightSlug?: string;
}

const { rows, highlightSlug } = Astro.props;

const tiers = cheatPages.map((c) => ({
  slug: c.slug,
  name: c.name,
  icon: cheatTierIcons[c.name] ?? 'crosshair',
  href: productPath(c.slug),
}));

const tierSlugs = tiers.map((t) => t.slug);
---

<section class="space-y-4" aria-labelledby="compare-heading">
  <header class="section-header">
    <p class="section-header__eyebrow">Compare</p>
    <h2 id="compare-heading" class="section-header__title">Compare all plans</h2>
    <p class="section-header__subtitle">Side-by-side look at what each tier includes.</p>
  </header>

  <div class="rounded-lg border border-border" tabindex="0" aria-label="Compare all plans">
    <Table>
      <TableHeader>
        <TableRow>
          <TableHead class="min-w-[12rem]">Feature</TableHead>
          {tiers.map((tier) => (
            <TableHead class="min-w-[8rem] text-center">
              <div class="flex flex-col items-center gap-2 py-2">
                {tier.slug === 'pro' && <Badge>Popular</Badge>}
                <a
                  href={tier.href}
                  class:list={[
                    'inline-flex flex-col items-center gap-1 text-sm font-semibold hover:text-primary',
                    highlightSlug === tier.slug && 'text-primary',
                  ]}
                >
                  <Icon
                    name={tier.icon}
                    size={22}
                    class={highlightSlug === tier.slug ? 'icon-app--primary' : ''}
                    aria-hidden="true"
                  />
                  {tier.name}
                </a>
              </div>
            </TableHead>
          ))}
        </TableRow>
      </TableHeader>
      <TableBody>
        {rows.map((row) => (
          <TableRow>
            <TableCell class="font-medium">
              <span class="inline-flex items-center gap-2">
                <Icon name={row.icon} size={15} aria-hidden="true" />
                {row.feature}
              </span>
            </TableCell>
            {tierSlugs.map((slug) => {
              const included = row[slug as keyof Pick<CompareRow, 'lite' | 'pro' | 'elite'>];
              return (
                <TableCell class="text-center">
                  <span aria-label={included ? 'Included' : 'Not included'}>
                    <Icon name={included ? 'circleCheck' : 'x'} size={18} />
                  </span>
                </TableCell>
              );
            })}
          </TableRow>
        ))}
      </TableBody>
    </Table>
  </div>
</section>
