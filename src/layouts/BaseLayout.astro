---
import '@/styles/starwind.css';
import { t } from '../i18n';
import { GA_MEASUREMENT_ID, RSS_FEED_PATH } from '../config/seo';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BaseHead from '../components/BaseHead.astro';
import {
  buildHreflangAlternates,
  canonicalForPathname,
  canonicalForRoute,
  getPageMeta,
  getPageMetaForPath,
  type PageMeta,
  type SeoRouteKey,
} from '../data/seo';
import { SEO_SITE_ORIGIN } from '../data/seo/constants';
import { buildSeoGraph } from '../utils/buildSeoGraph';

interface Props {
  seoRoute?: SeoRouteKey;
  pageMeta?: PageMeta;
  canonicalOverride?: string;
  extraJsonLd?: Record<string, unknown>[];
  skipHreflang?: boolean;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  noindex?: boolean;
  homePage?: boolean;
  locale?: string;
}

const {
  seoRoute,
  pageMeta: pageMetaOverride,
  canonicalOverride,
  extraJsonLd = [],
  skipHreflang = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  noindex = false,
  homePage = false,
  locale = 'en',
} = Astro.props;

const meta = pageMetaOverride ?? (seoRoute ? getPageMeta(seoRoute) : getPageMetaForPath(Astro.url.pathname));
const canonical =
  canonicalOverride ?? (seoRoute ? canonicalForRoute(seoRoute) : canonicalForPathname(Astro.url.pathname));
const alternates = skipHreflang ? [] : buildHreflangAlternates(meta.route, SEO_SITE_ORIGIN);
const jsonLdGraph = [...buildSeoGraph(meta, canonical), ...extraJsonLd];
---

<!doctype html>
<html lang={locale} dir="ltr" class="dark fonts-pending">
  <head>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('colorTheme') || localStorage.getItem('starwind-theme');
          if (stored === 'light') document.documentElement.classList.remove('dark');
          else if (stored === 'dark') document.documentElement.classList.add('dark');
        } catch (e) {}
        document.documentElement.classList.add('fonts-pending');
      })();
    </script>
    <BaseHead
      meta={meta}
      canonical={canonical}
      locale={locale}
      dir="ltr"
      alternates={alternates}
      jsonLdGraph={jsonLdGraph}
      ogType={ogType}
      noindex={noindex}
    >
      <link
        rel="alternate"
        type="application/rss+xml"
        title={`${t.site.name} Blog RSS`}
        href={RSS_FEED_PATH}
      />
      {
        ogType === 'article' && articlePublishedTime && (
          <>
            <meta property="article:published_time" content={articlePublishedTime} />
            <meta
              property="article:modified_time"
              content={articleModifiedTime ?? articlePublishedTime}
            />
            <meta property="article:author" content={t.site.name} />
          </>
        )
      }
      <slot name="head" />
    </BaseHead>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=optional"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&display=optional"
        rel="stylesheet"
      />
    </noscript>
  </head>
  <body class:list={['min-h-screen bg-background text-foreground', homePage && 'page-home']}>
    <button type="button" class="skip-link" data-skip-to-main>{t.ui.skipLink}</button>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/site.ts';
    </script>
    {
      GA_MEASUREMENT_ID && (
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          (() => {
            const loadGa = () => {
              if (window.__gaLoaded) return;
              window.__gaLoaded = true;
              window.dataLayer = window.dataLayer || [];
              function gtag() {
                dataLayer.push(arguments);
              }
              gtag('js', new Date());
              gtag('config', GA_MEASUREMENT_ID, { anonymize_ip: true });
              const s = document.createElement('script');
              s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_MEASUREMENT_ID;
              s.async = true;
              document.head.appendChild(s);
            };
            const onReady = () => {
              if (typeof window.requestIdleCallback === 'function') {
                window.requestIdleCallback(loadGa, { timeout: 4000 });
              } else {
                window.setTimeout(loadGa, 2500);
              }
            };
            if (document.readyState === 'complete') onReady();
            else window.addEventListener('load', onReady, { once: true });
          })();
        </script>
      )
    }
  </body>
</html>
