---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  blogPosts,
  getBlogTags,
  getFeaturedBlogPost,
  getNonFeaturedBlogPosts,
} from '../../data/blog';
import { t } from '../../i18n';
import { BLOG_HERO_IMAGE_WIDTHS, webpSrc } from '../../utils/responsiveImage';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import BlogSortSelect from '../../components/BlogSortSelect.astro';
import Icon from '../../components/icons/Icon.astro';
import { blogTagIcons } from '../../data/sectionIcons';
import type { IconName } from '../../components/icons/types';
import { Button } from '@/components/starwind/button';
import { ROUTES } from '../../utils/path';

const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Blog', path: '/blog/' },
];

const featured = getFeaturedBlogPost();
const gridPosts = getNonFeaturedBlogPosts();
const tags = getBlogTags();
const lcpImage = webpSrc(
  featured?.image ?? blogPosts[0]!.image,
  BLOG_HERO_IMAGE_WIDTHS[BLOG_HERO_IMAGE_WIDTHS.length - 1]!,
);

const tagIcon = (tag: string): IconName => blogTagIcons[tag] ?? 'tag';
---

<BaseLayout seoRoute="/blog/">
  <link slot="head" rel="preload" as="image" href={lcpImage} type="image/webp" fetchpriority="high" />

  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />

      <header class="mt-6 flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
        <div class="max-w-2xl space-y-3">
          <h1 class="text-3xl font-bold uppercase md:text-4xl">{t.blog.title}</h1>
          <p class="text-lg text-muted-foreground">{t.blog.subtitle}</p>
        </div>
        <BlogSortSelect />
      </header>

      {
        featured && (
          <article class="mt-10">
            <BlogCard post={featured} featured showDate />
          </article>
        )
      }

      <div class="mt-10 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <Button as="a" href={`${ROUTES.blog}?tag=${encodeURIComponent(tag)}`} variant="outline" size="sm">
            <Icon name={tagIcon(tag)} size={16} />
            {tag}
          </Button>
        ))}
      </div>

      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {gridPosts.map((post) => (
          <BlogCard post={post} />
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
