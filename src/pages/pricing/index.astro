---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PlanCheckoutPanel from '../../components/product/PlanCheckoutPanel.astro';
import { productPath } from '../../utils/path';
import { Button } from '@/components/starwind/button';
import Icon from '../../components/icons/Icon.astro';
---

<BaseLayout seoRoute="/pricing/">
  <section class="py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs
        items={[
          { name: 'Home', path: '/' },
          { name: 'Store', path: '/pricing/' },
        ]}
      />
      <header class="mt-6 max-w-3xl space-y-4">
        <h1 class="text-3xl font-bold uppercase md:text-4xl">Enlisted Cloud DMA store</h1>
        <p class="text-lg text-muted-foreground">
          Aimbot, ESP and wallhack over Cloud DMA — choose 1 week, 1 month, or lifetime. Instant delivery after
          Levocheats checkout.
        </p>
      </header>

      <div class="mt-10 grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:items-start">
        <div class="space-y-4 text-sm text-muted-foreground">
          <p>
            All plans include portal access, Discord onboarding for supported DMA hardware, and patch-day firmware
            updates when Enlisted or BattlEye changes.
          </p>
          <Button as="a" href={productPath('cloud-dma')} variant="outline" size="sm" class="rounded-full">
            Cloud DMA feature list
            <Icon name="arrowRight" size={16} />
          </Button>
        </div>
        <aside
          class="overflow-hidden rounded-2xl border border-primary/35 bg-card p-5 shadow-md ring-1 ring-primary/15 md:p-6"
          aria-label="Cloud DMA pricing"
        >
          <PlanCheckoutPanel productSlug="cloud-dma" planHeading="Select plan" />
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>
