---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoContentShell from '../../components/SeoContentShell.astro';
---

<BaseLayout seoRoute="/updates/">
  <SeoContentShell
    title="Enlisted status"
    lead="Check undetected status after Enlisted or Easy Anti-Cheat patches before you queue."
  >
    <p class="rounded-xl border border-primary/30 bg-primary/5 px-4 py-3 font-medium text-foreground">
      Current status: undetected — check this page after every Enlisted or Easy Anti-Cheat patch before you queue.
    </p>
    <p class="mt-4">
      Maintenance notes land here first when a patch requires a new Enlisted Hacks build. Bookmark this page and
      confirm status before every session on Windows PC.
    </p>
  </SeoContentShell>
</BaseLayout>
