---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import LegalPage from '../components/LegalPage.astro';
import { getPageMeta, mergePageMeta } from '../data/seo';

const seo = resolvePageSeo('/about/');
const content = t.legalPages.about;
const pageMeta = mergePageMeta(getPageMeta('/'), {
  title: seo.title,
  description: seo.description,
  breadcrumbs: [
    { name: 'Home', path: '/' },
    { name: 'About', path: '/about/' },
  ],
  includeProduct: false,
  includeFaqPage: false,
});
---

<BaseLayout pageMeta={pageMeta} skipHreflang>
  <LegalPage
    title={content.title}
    description={content.description}
    breadcrumbLabel="About"
    sections={content.sections}
  />
</BaseLayout>
