---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getAllProductSlugs, getProductPage, productHub } from '../../../data/products';
import { pageTitle } from '../../../config/seo';
import { getPageSeoEntry } from '../../../config/pageSeo';
import { getPageMeta, mergePageMeta } from '../../../data/seo';
import { productSchema } from '../../../utils/schema';
import ProductDetail from '../../../components/ProductDetail.astro';

export function getStaticPaths() {
  return getAllProductSlugs().map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const product = getProductPage(slug!);

if (!product) {
  return Astro.redirect(productHub.path);
}

const pagePath = `${productHub.path}${product.slug}/`;
const seoEntry = getPageSeoEntry(pagePath);
const metaTitle = seoEntry?.title ?? pageTitle(`Buy ${product.title}`);
const metaDescription =
  seoEntry?.description ??
  `Buy ${product.title} Enlisted hacks — ${product.desc}`;
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: productHub.path },
  { name: product.title, path: pagePath },
];
const pageMeta = mergePageMeta(getPageMeta('/enlisted-hacks/'), {
  title: metaTitle,
  description: metaDescription,
  ogImage: product.images[0]?.src ?? getPageMeta('/enlisted-hacks/').ogImage,
  ogImageAlt: product.title,
  breadcrumbs,
  includeProduct: false,
});
const productLd = productSchema({
  name: product.title,
  description: metaDescription,
  url: pagePath,
  offerUrl: product.buyUrl,
  image: product.images[0]?.src,
  sku: product.slug,
});
---

<BaseLayout pageMeta={pageMeta} extraJsonLd={[productLd]} skipHreflang>
  <ProductDetail product={product} breadcrumbs={breadcrumbs} />
</BaseLayout>
