---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSection from '../components/HeroSection.astro';
import FeaturesSection from '../components/FeaturesSection.astro';
import WhySetupSection from '../components/WhySetupSection.astro';
import ProductsSection from '../components/ProductsSection.astro';
import ContentSections from '../components/ContentSections.astro';
import { webpSrc } from '../utils/responsiveImage';

const heroLcpImage = webpSrc('/images/gameplay/enlisted-esp-wallhack.png', 512);
---

<BaseLayout homePage seoRoute="/">
  <link
    slot="head"
    rel="preconnect"
    href="https://fonts.googleapis.com"
  />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Rajdhani:wght@600;700&display=swap"
    rel="stylesheet"
  />
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroLcpImage}
    type="image/webp"
    media="(min-width: 1024px)"
    fetchpriority="high"
  />
  <HeroSection />
  <FeaturesSection />
  <ProductsSection />
  <WhySetupSection />
  <ContentSections />
</BaseLayout>
