{
  "name": "enlisted-hacks-cheats",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/optimize-images.mjs && astro build && node scripts/prune-dist-images.mjs && node scripts/finalize-sitemap.mjs && node scripts/indexnow.mjs",
    "preview": "astro preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "deploy": "npx wrangler deploy",
    "astro": "astro",
    "optimize:images": "node scripts/optimize-images.mjs",
    "images:enlisted": "node scripts/import-user-gameplay.mjs && node scripts/fetch-enlisted-gameplay.mjs && node scripts/optimize-images.mjs",
    "images:seo-og": "node scripts/generate-seo-og-images.mjs",
    "test:seo": "tsx --test tests/seo-meta.test.ts tests/seo-site.test.ts",
    "test:checkout": "tsx --test tests/checkout-links.test.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@lucide/astro": "^1.48.0",
    "@starwind-ui/astro": "^1.2.1",
    "@tabler/icons": "^3.48.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "sharp": "^0.34.3",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.9.2"
  }
}
